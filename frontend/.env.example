# Copy to .env.local. NEXT_PUBLIC_* values are sent to the browser: never put secrets in them.

# FastAPI base URL (backend/: `uv run uvicorn app.main:create_app --factory --reload` serves it on port 8000).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# "enabled" serves API requests from MSW mocks in the browser (no backend needed);
# anything else (the default) calls the real API at NEXT_PUBLIC_API_BASE_URL.
NEXT_PUBLIC_API_MOCKING=disabled

# Shown in the dev test console; CI sets it to the git commit SHA.
NEXT_PUBLIC_COMMIT_SHA=local

# "true" in production over HTTPS. Leave it off locally, where there's no HTTPS.
ENABLE_HSTS=false
