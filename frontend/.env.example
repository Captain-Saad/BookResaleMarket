# Copy to .env.local. NEXT_PUBLIC_* values are sent to the browser: never put secrets in them.

# FastAPI base URL (backend/: `uv run uvicorn app.main:create_app --factory --reload` serves it on port 8000).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# "disabled" sends dev requests to the real API; anything else serves them from MSW mocks.
NEXT_PUBLIC_API_MOCKING=enabled

# Shown in the dev test console; CI sets it to the git commit SHA.
NEXT_PUBLIC_COMMIT_SHA=local
