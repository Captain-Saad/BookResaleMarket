{
  "name": "@bookloop/api-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./schema": {
      "types": "./schema.d.ts"
    }
  },
  "scripts": {
    "export": "cd ../../backend && uv run python -m scripts.export_openapi",
    "generate": "pnpm export && openapi-typescript openapi.json -o schema.d.ts"
  },
  "devDependencies": {
    "openapi-typescript": "7.13.0"
  }
}
