{
  "components": {
    "schemas": {
      "ClockAdvanceRequest": {
        "properties": {
          "hours": {
            "maximum": 720.0,
            "minimum": 1.0,
            "title": "Hours",
            "type": "integer"
          }
        },
        "required": [
          "hours"
        ],
        "title": "ClockAdvanceRequest",
        "type": "object"
      },
      "ClockResponse": {
        "properties": {
          "advancedHours": {
            "title": "Advancedhours",
            "type": "integer"
          },
          "now": {
            "format": "date-time",
            "title": "Now",
            "type": "string"
          }
        },
        "required": [
          "now",
          "advancedHours"
        ],
        "title": "ClockResponse",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "const": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "ProblemDetails": {
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Detail"
          },
          "errors": {
            "anyOf": [
              {
                "items": {
                  "additionalProperties": true,
                  "type": "object"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Errors"
          },
          "request_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Request Id"
          },
          "status": {
            "title": "Status",
            "type": "integer"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "type": {
            "default": "about:blank",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "title",
          "status",
          "code"
        ],
        "title": "ProblemDetails",
        "type": "object"
      },
      "ReadyResponse": {
        "properties": {
          "database": {
            "const": "ok",
            "title": "Database",
            "type": "string"
          },
          "redis": {
            "const": "ok",
            "title": "Redis",
            "type": "string"
          },
          "status": {
            "const": "ready",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "database",
          "redis"
        ],
        "title": "ReadyResponse",
        "type": "object"
      },
      "ResetResponse": {
        "properties": {
          "reset": {
            "title": "Reset",
            "type": "integer"
          }
        },
        "required": [
          "reset"
        ],
        "title": "ResetResponse",
        "type": "object"
      },
      "SeedResponse": {
        "properties": {
          "seeded": {
            "title": "Seeded",
            "type": "integer"
          }
        },
        "required": [
          "seeded"
        ],
        "title": "SeedResponse",
        "type": "object"
      },
      "SessionRequest": {
        "properties": {
          "role": {
            "enum": [
              "buyer",
              "seller",
              "warehouse",
              "courier",
              "dispatcher",
              "admin"
            ],
            "title": "Role",
            "type": "string"
          }
        },
        "required": [
          "role"
        ],
        "title": "SessionRequest",
        "type": "object"
      },
      "SessionResponse": {
        "properties": {
          "role": {
            "enum": [
              "buyer",
              "seller",
              "warehouse",
              "courier",
              "dispatcher",
              "admin"
            ],
            "title": "Role",
            "type": "string"
          }
        },
        "required": [
          "role"
        ],
        "title": "SessionResponse",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "BookLoop API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/dev/clock/advance": {
      "post": {
        "operationId": "advance_clock_api_v1_dev_clock_advance_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ClockAdvanceRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClockResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Move the backend clock forward",
        "tags": [
          "dev"
        ]
      }
    },
    "/api/v1/dev/reset": {
      "post": {
        "description": "Number of records removed. Nothing to reset until the first tables arrive (S1).",
        "operationId": "reset_api_v1_dev_reset_post",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResetResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Reset dev data",
        "tags": [
          "dev"
        ]
      }
    },
    "/api/v1/dev/seed": {
      "post": {
        "description": "Number of records created. Nothing to seed until the first tables arrive (S1).",
        "operationId": "seed_api_v1_dev_seed_post",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SeedResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Seed dev data",
        "tags": [
          "dev"
        ]
      }
    },
    "/api/v1/dev/session": {
      "post": {
        "operationId": "switch_session_api_v1_dev_session_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SessionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Act as a role",
        "tags": [
          "dev"
        ]
      }
    },
    "/healthz": {
      "get": {
        "description": "The process is up and serving requests. Checks no dependencies.",
        "operationId": "healthz_healthz_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Liveness check",
        "tags": [
          "health"
        ]
      }
    },
    "/readyz": {
      "get": {
        "description": "The process can serve traffic: the database and Redis answer within the timeout.",
        "operationId": "readyz_readyz_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadyResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "A dependency is unavailable"
          }
        },
        "summary": "Readiness check",
        "tags": [
          "health"
        ]
      }
    }
  }
}
