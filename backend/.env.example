# Copy to backend/.env and adjust. Never commit real secrets; .env files are gitignored.

# development | test | production. Production hides /docs (and, later, all dev-only routes).
BOOKLOOP_ENV=development

# DEBUG | INFO | WARNING | ERROR
BOOKLOOP_LOG_LEVEL=INFO

# true = one JSON object per line (production); false = coloured human-readable output.
BOOKLOOP_LOG_JSON=false

# Required unless BOOKLOOP_ENV=test (startup fails fast without them).
# Supabase → Project → Connect. Paste the URIs as shown ("postgresql://…"), password filled in.
# Transaction pooler (port 6543): used by the running API.
BOOKLOOP_DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:6543/postgres
# Direct connection or session pooler (port 5432): used by Alembic migrations.
BOOKLOOP_DATABASE_DIRECT_URL=postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:5432/postgres

# Seconds /readyz waits for the database before reporting 503.
BOOKLOOP_READINESS_TIMEOUT_SECONDS=5

# Redis for the ARQ job queue. `docker compose up -d redis` (repo root) serves it on port 6380.
BOOKLOOP_REDIS_URL=redis://localhost:6380/0

# Browser origins allowed to call the API (JSON list). The Next.js dev server runs on :3000.
BOOKLOOP_CORS_ORIGINS=["http://localhost:3000"]

# Outgoing email. `docker compose up -d mailpit` (repo root) catches it locally:
# read messages at http://localhost:8025.
BOOKLOOP_SMTP_HOST=localhost
BOOKLOOP_SMTP_PORT=1025
BOOKLOOP_EMAIL_FROM=BookLoop <no-reply@bookloop.test>

# Links in emails point here.
BOOKLOOP_FRONTEND_BASE_URL=http://localhost:3000

# Host names this API answers to (JSON list). Set this to the API's real host in production.
BOOKLOOP_ALLOWED_HOSTS=["localhost", "127.0.0.1"]

# Listing photos: create a PRIVATE bucket with a 5 MiB file limit and JPEG/PNG/WebP MIME types.
# Leave both unset for local development storage (backend/var/listing-photos).
# Production photo operations fail closed without configured storage.
BOOKLOOP_STORAGE_URL=
BOOKLOOP_STORAGE_SERVICE_KEY=
BOOKLOOP_STORAGE_BUCKET=listing-photos

# Optional fast public catalog reads: use a SESSION pooler (5432) or direct URL.
# Never use the Supabase transaction pooler (6543) here. Empty preserves transactional reads.
BOOKLOOP_PUBLIC_DATABASE_URL=
