# Copy to backend/.env and adjust. Never commit real secrets; .env files are gitignored.

# development | test | production. Production hides /docs (and, later, all dev-only routes).
BOOKLOOP_ENV=development

# DEBUG | INFO | WARNING | ERROR
BOOKLOOP_LOG_LEVEL=INFO

# true = one JSON object per line (production); false = coloured human-readable output.
BOOKLOOP_LOG_JSON=false

# Required unless BOOKLOOP_ENV=test (startup fails fast without them).
# Supabase → Project → Connect. Paste the URIs as shown ("postgresql://…"), password filled in.
# Transaction pooler (port 6543): used by the running API.
BOOKLOOP_DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:6543/postgres
# Direct connection or session pooler (port 5432): used by Alembic migrations.
BOOKLOOP_DATABASE_DIRECT_URL=postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:5432/postgres

# Seconds /readyz waits for the database before reporting 503.
BOOKLOOP_READINESS_TIMEOUT_SECONDS=5
